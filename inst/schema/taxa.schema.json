{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://calcofi.io/schema/taxa.schema.json",
  "title": "CalCOFI species catalog record (taxa.json)",
  "description": "One record per release: every taxon of the release's taxon table with an observation at or below it, its lineage, its per-dataset observations and the names each dataset uses. Written by calcofi4db::build_taxa_catalog() beside datasets.json; read by calcofi.io/species/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "counts", "datasets", "taxa"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "release": {
      "type": "object", "additionalProperties": false, "required": ["version", "release_date"],
      "properties": {
        "version": { "type": "string", "pattern": "^v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$" },
        "release_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["taxa_observed", "species_observed", "taxon_rows", "datasets", "pages", "obs_bio_rows"],
      "properties": {
        "taxa_observed":    { "type": "integer", "minimum": 0, "description": "distinct obs_bio.taxon_key" },
        "species_observed": { "type": "integer", "minimum": 0, "description": "of those, rank == Species" },
        "taxon_rows":       { "type": "integer", "minimum": 0, "description": "rows of the taxon table" },
        "datasets":         { "type": "integer", "minimum": 0, "description": "datasets carrying a taxon (observed or in vocabulary)" },
        "pages":            { "type": "integer", "minimum": 0, "description": "length of taxa[]: observed taxa plus their ancestors" },
        "obs_bio_rows":     { "type": "integer", "minimum": 0, "description": "rows of obs_bio with a taxon_key; equals the rollup n_obs of the roots" }
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dataset_key", "dataset_name_short", "color", "category", "n_obs", "n_present", "n_taxa", "vocabulary_only"],
        "properties": {
          "dataset_key":        { "type": "string" },
          "dataset_name_short": { "type": "string" },
          "color":              { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "category": {
            "type": "object", "additionalProperties": false, "required": ["name", "realm"],
            "properties": {
              "key":   { "type": ["string", "null"] },
              "name":  { "type": "string" },
              "icon":  { "type": ["string", "null"] },
              "realm": { "type": "string", "enum": ["bio", "env"] },
              "order": { "type": ["integer", "null"] }
            }
          },
          "n_obs":  { "type": "integer", "minimum": 0, "description": "obs_bio rows of this dataset with a taxon_key" },
          "n_present": { "type": "integer", "minimum": 0, "description": "of those, the rows with value > 0 (a NULL or NaN is not present)" },
          "n_taxa": { "type": "integer", "minimum": 0, "description": "distinct taxa observed in this dataset" },
          "vocabulary_only": {
            "type": "array", "description": "dataset_taxon rows of this dataset whose taxon has no observation anywhere (no page)",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["taxon_key", "name", "code"],
              "properties": { "taxon_key": { "type": "string" }, "name": { "type": ["string", "null"] }, "code": { "type": ["string", "null"] } }
            }
          }
        }
      }
    },
    "taxa": { "type": "array", "items": { "$ref": "#/definitions/taxon" } }
  },
  "definitions": {
    "nullable_string":  { "type": ["string", "null"] },
    "nullable_integer": { "type": ["integer", "null"] },
    "taxon": {
      "type": "object", "additionalProperties": false,
      "required": ["taxon_key", "slug", "scientific_name", "common_name", "rank", "rank_order", "taxonomic_status", "status_checked", "parent_taxon_key", "lineage", "ids", "groups", "direct", "rollup", "datasets"],
      "properties": {
        "taxon_key":        { "type": "string", "description": "worms:<AphiaID> · itis:<TSN> · <dataset_key>:<code> for a dataset-local class" },
        "slug":             { "type": "string", "pattern": "^[A-Za-z0-9_.-]+-[0-9A-Za-z_.-]+$", "description": "taxon_key with its ':' written '-': the page directory /species/{slug}/" },
        "scientific_name":  { "$ref": "#/definitions/nullable_string" },
        "common_name":      { "$ref": "#/definitions/nullable_string" },
        "rank":             { "$ref": "#/definitions/nullable_string" },
        "rank_order":       { "$ref": "#/definitions/nullable_integer" },
        "taxonomic_status": { "$ref": "#/definitions/nullable_string" },
        "status_checked":   { "$ref": "#/definitions/nullable_string" },
        "parent_taxon_key": { "$ref": "#/definitions/nullable_string", "description": "null for a root (worms:1 Biota, a dataset-local class)" },
        "lineage": {
          "type": "object", "additionalProperties": false, "required": ["kingdom", "phylum", "class", "order", "family"],
          "properties": {
            "kingdom": { "$ref": "#/definitions/nullable_string" }, "phylum": { "$ref": "#/definitions/nullable_string" },
            "class":   { "$ref": "#/definitions/nullable_string" }, "order":  { "$ref": "#/definitions/nullable_string" },
            "family":  { "$ref": "#/definitions/nullable_string" }
          }
        },
        "ids": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "worms_id": { "$ref": "#/definitions/nullable_integer" }, "itis_id": { "$ref": "#/definitions/nullable_integer" },
            "gbif_id":  { "$ref": "#/definitions/nullable_integer" }, "ncbi_id": { "$ref": "#/definitions/nullable_integer" },
            "inat_id":  { "$ref": "#/definitions/nullable_integer" }
          }
        },
        "local": {
          "type": "object", "additionalProperties": false, "description": "present only for a dataset-local class (a key that is not worms: or itis:)",
          "required": ["dataset_key", "name", "common_name", "code"],
          "properties": { "dataset_key": { "type": "string" }, "name": { "$ref": "#/definitions/nullable_string" }, "common_name": { "$ref": "#/definitions/nullable_string" }, "code": { "$ref": "#/definitions/nullable_string" } }
        },
        "groups": { "type": "array", "items": { "type": "string" }, "description": "taxon_group keys this taxon belongs to" },
        "notes":  { "$ref": "#/definitions/nullable_string" },
        "direct": {
          "type": "object", "additionalProperties": false, "description": "observations keyed to this taxon itself",
          "required": ["n_obs", "n_present", "n_samples", "n_datasets", "year_min", "year_max", "life_stages"],
          "properties": {
            "n_obs": { "type": "integer", "minimum": 0 }, "n_present": { "type": "integer", "minimum": 0, "description": "of n_obs, the rows with value > 0" }, "n_samples": { "type": "integer", "minimum": 0 }, "n_datasets": { "type": "integer", "minimum": 0 },
            "year_min": { "$ref": "#/definitions/nullable_integer" }, "year_max": { "$ref": "#/definitions/nullable_integer" },
            "life_stages": { "type": "array", "items": { "type": "string" } }
          }
        },
        "rollup": {
          "type": "object", "additionalProperties": false, "description": "this taxon and every descendant in taxa[]",
          "required": ["n_obs", "n_present", "n_taxa", "n_species", "n_datasets", "year_min", "year_max"],
          "properties": {
            "n_obs": { "type": "integer", "minimum": 0 }, "n_present": { "type": "integer", "minimum": 0, "description": "of n_obs, the rows with value > 0" }, "n_taxa": { "type": "integer", "minimum": 0 }, "n_species": { "type": "integer", "minimum": 0 }, "n_datasets": { "type": "integer", "minimum": 0 },
            "year_min": { "$ref": "#/definitions/nullable_integer" }, "year_max": { "$ref": "#/definitions/nullable_integer" }
          }
        },
        "datasets": {
          "type": "array", "description": "one per dataset with a direct observation of this taxon, most observations first",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["dataset_key", "n_obs", "n_present", "n_samples", "year_min", "year_max", "life_stages", "years", "sources"],
            "properties": {
              "dataset_key": { "type": "string" },
              "n_obs": { "type": "integer", "minimum": 1 }, "n_present": { "type": "integer", "minimum": 0, "description": "of n_obs, the rows with value > 0" }, "n_samples": { "type": "integer", "minimum": 0 },
              "year_min": { "$ref": "#/definitions/nullable_integer" }, "year_max": { "$ref": "#/definitions/nullable_integer" },
              "life_stages": { "type": "array", "items": { "type": "string" } },
              "years": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 }, "propertyNames": { "pattern": "^[0-9]{4}$" }, "description": "observations per year" },
              "sources": {
                "type": "array", "description": "the dataset_taxon rows of this dataset that resolve to this taxon: what the dataset calls it",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["name", "common_name", "code", "ids", "flags"],
                  "properties": {
                    "name":        { "$ref": "#/definitions/nullable_string" },
                    "common_name": { "$ref": "#/definitions/nullable_string" },
                    "code":        { "$ref": "#/definitions/nullable_string" },
                    "ids": { "type": "object", "additionalProperties": false, "description": "the ids the source itself supplied (ds_source_json)",
                             "properties": { "worms_id": { "$ref": "#/definitions/nullable_integer" }, "itis_id": { "$ref": "#/definitions/nullable_integer" }, "gbif_id": { "$ref": "#/definitions/nullable_integer" } } },
                    "flags": { "type": "array", "items": { "type": "string", "enum": ["synonym", "sp_to_genus", "rekeyed", "id_conflict", "no_name"] },
                               "description": "synonym: the name is not the accepted name · sp_to_genus: a 'sp.' name resolved to its genus · rekeyed: the KEY authority's id the source supplied was deprecated, re-keyed to the successor (an itis: key compares itis_id, a worms: key worms_id; a dataset-local key never re-keys) · id_conflict: the source's id for a secondary authority disagrees with the key authority's cross-reference · no_name: the dataset carries only a code" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
